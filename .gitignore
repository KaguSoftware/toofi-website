# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sawad local-mode data store + uploads (delete to reset sample data)
/.data/

# sawad compound build (scripts/blender/build.sh): downloaded CC0 sources and intermediates
/scripts/blender/textures/
/scripts/blender/out/

# git worktrees used by parallel agent sessions (each is a full checkout, never committed)
/.claude/worktrees/
