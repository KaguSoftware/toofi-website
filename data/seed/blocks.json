  {
    "scope": "5aeb666d-2cb3-4b22-9454-9fe0e15c3dde",
    "key": "title",
    "type": "text",
    "value": {
      "text": "About Toofi"
    }
  },
  {
    "scope": "5aeb666d-2cb3-4b22-9454-9fe0e15c3dde",
    "key": "body",
    "type": "richtext",
    "value": {
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Toofi is a small studio that believes good software should feel calm. We design and build websites and products with a bias for restraint."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "What we believe"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Fewer things, done properly."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Speed is a feature."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Accessibility is not optional."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "How we work"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "We start with the content, choose a simple structure, and refine the details until nothing feels accidental. "
              },
              {
                "type": "text",
                "text": "Say hello",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "/contact"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " if that sounds like your kind of project."
              }
            ]
          }
        ]
      }
    }
